# Server-only — forwarded by the BFF as X-Api-Key (never expose to the browser).
BOND_API_BASE_URL=https://public.api.squad-c.bondsports.co
BOND_API_KEY=

# Bond auth host (consumer login + refresh) — server-only proxy at /api/bond-auth/*
BOND_AUTH_BASE_URL=https://api.squad-c.bondsports.co

# Optional: override host for GET /v4/payment/organization/.../options (defaults to BOND_AUTH_BASE_URL)
# BOND_PAYMENT_API_BASE_URL=

# Public — org and portal the UI loads (from Bond backoffice).
NEXT_PUBLIC_BOND_ORG_ID=155
NEXT_PUBLIC_BOND_PORTAL_ID=133

# Optional — consumer web shell (reservations / invoice pages). Defaults to https://squad-c.bondsports.co
# NEXT_PUBLIC_BOND_CONSUMER_WEB_ORIGIN=https://squad-c.bondsports.co

# Bond Sports SDK (browser PKCE auth + public API). All NEXT_PUBLIC_* — exposed to the client.
# Authority + ClientId MUST come from the same Cognito user pool. Cross-pool values yield
# "Login pages unavailable" errors. Format the authority as:
#   https://cognito-idp.<region>.amazonaws.com/<userPoolId>
# Find your pool id at: AWS Console → Cognito → User pools → <your pool> → User pool overview.
# ClientId is from: same pool → App integration → App clients → <your app client> → Client ID.
# RedirectUri is an absolute URL pointing at /auth/callback in this app.
NEXT_PUBLIC_BOND_OAUTH_AUTHORITY=
NEXT_PUBLIC_BOND_OAUTH_CLIENT_ID=
NEXT_PUBLIC_BOND_OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback
NEXT_PUBLIC_BOND_PUBLIC_API_KEY=
NEXT_PUBLIC_BOND_PUBLIC_API_BASE_URL=https://public.api.squad-c.bondsports.co

# ─── Branding (demo overrides) ───────────────────────────────────────────────
# Override the org name shown across the portal (header, login drawer, summary).
# Falls back to portal.name from the Bond API, then "Bond Sports".
NEXT_PUBLIC_BOND_ORG_NAME=Sonic Squad
# Logo URL (absolute or rooted path). Falls back to portal.options.branding.logoUrl.
# Local default ships at /images/sonic-squad-logo.png; can also point at a CDN URL.
NEXT_PUBLIC_BOND_ORG_LOGO_URL=/images/sonic-squad-logo.png
# Optional dark-mode logo override (UIs fall back to NEXT_PUBLIC_BOND_ORG_LOGO_URL).
# NEXT_PUBLIC_BOND_ORG_LOGO_DARK_URL=

# Theme (CSS custom properties). Resolution: URL params > portal branding > env > defaults.
# These match the Sonic Squad demo palette.
# Hex values must be quoted — `#` is the comment marker in .env files.
NEXT_PUBLIC_BOOKING_PRIMARY="#0d4774"
NEXT_PUBLIC_BOOKING_ACCENT="#f7b500"
NEXT_PUBLIC_BOOKING_SURFACE="#f0f4f7"
# NEXT_PUBLIC_BOOKING_SUCCESS="#0d4774"
# NEXT_PUBLIC_BOOKING_BG_PAGE="#ffffff"

# All branding values are also overridable via URL params for ad-hoc demos:
#   ?orgName=Acme+Sports&logoUrl=https%3A%2F%2F…%2Flogo.png
#   ?primary=%230d4774&accent=%23f7b500&surface=%23f0f4f7

